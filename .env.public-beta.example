# AI-LifeOS Web Public Beta — production template
# Copy to a server-only environment file outside the Git checkout.
# Never commit real secrets or user credentials.

NODE_ENV=production
AIOS_PUBLIC_BETA_HOSTS=beta.example.com
AIOS_PUBLIC_BETA_DEPLOYMENT_MODE=single-instance
AIOS_PUBLIC_BETA_INSTANCE_COUNT=1
AIOS_PUBLIC_BETA_STATE_BACKEND=memory-single-instance
AIOS_PUBLIC_BETA_INSTANCE_ID=tencent-node-01
AIOS_PUBLIC_BETA_RELEASE_ID=beta-YYYY-MM-DD-gitsha
AIOS_PUBLIC_BETA_SOURCE_URL=https://example.com/ai-lifeos/releases/beta-YYYY-MM-DD-gitsha
AIOS_PUBLIC_BETA_INGRESS_SECRET=replace-with-a-random-server-secret-at-least-32-characters
AIOS_PUBLIC_BETA_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Fixed server-side provider selection. Public requests still must provide
# their own TokenHub API Key in each request.
LIFE_AI_PROVIDER=tokenhub
TENCENT_TOKENHUB_MODEL_ID=deepseek-v4.1-flash-1017
TENCENT_TOKENHUB_LIFE_MAX_OUTPUT_TOKENS=900

# These developer/private credentials MUST stay unset in the Public Beta
# process. The runtime gate rejects the public host if any are configured.
TENCENT_TOKENHUB_API_KEY=
OPENROUTER_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Personal Alpha stays disabled in the public deployment template.
AIOS_PERSONAL_ALPHA_BYOK=0
AIOS_PERSONAL_ALPHA_BYOK_HOST=

# Legacy and local-only integrations stay disabled.
AIOS_ENABLE_HEALTH_API=false
AIOS_ENABLE_TELEGRAM_API=false
AIOS_PUBLIC_TEST_HOSTS=
