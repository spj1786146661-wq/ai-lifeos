# ============================================================
# LifeTracker — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub
# ============================================================

# ------ Firebase (firebase.google.com → Project Settings → Your apps) ------
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Firebase Admin SDK (server-side — used by Telegram bots and API routes)
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
# Minify the JSON to a single line: jq -c . firebase-admin-key.json
# Then paste the entire minified string as the value below
FIREBASE_SERVICE_ACCOUNT=

# Firebase Vapid Key (for push notifications via FCM)
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key-here

# ------ OpenRouter AI (openrouter.ai → Keys) ------
# DeepSeek V3 is the default model — cheap and capable for all AI features
OPENROUTER_API_KEY=
# 留空时「人生数据舱」明确进入规则演示模式；真实密钥仅放在 .env.local，勿用 NEXT_PUBLIC_ 前缀。
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat

# 可选：视觉模型（图片识别）。留空时图片接口返回 503，页面明确显示"视觉识别尚未配置"，
# 并允许你手动为图片选择分类后保存，不会返回任何虚构的识别内容。
# 必须是可以接收图片的模型；不要把纯文本模型写在这里。
OPENROUTER_VISION_MODEL=

# ------ 腾讯云 TokenHub DeepSeek ---------------------------------------------
# 同时供 /model-test 和正式生活记录解析使用。真实 Key 仅放 .env.local。
# 端点在服务端固定；模型由以下环境变量选择：
# https://tokenhub.tencentmaas.com/v1/chat/completions
TENCENT_TOKENHUB_API_KEY=
# 可选：TokenHub 模型 ID。未填写时沿用 deepseek/deepseek-flash。
# 当前个人环境使用 deepseek-v4.1-flash-1017。
TENCENT_TOKENHUB_MODEL_ID=deepseek/deepseek-flash
# 可选：正式生活记录解析的输出预算，默认 900，运行时限制在 128–2000。
TENCENT_TOKENHUB_LIFE_MAX_OUTPUT_TOKENS=900
# 可选：显式选择正式文字解析 Provider。
# auto（默认）：TokenHub Key 存在时优先 TokenHub，否则沿用 ChatGPT / OpenRouter。
# 也可填写 tokenhub、chatgpt 或 openrouter；指定项不可用时只降级到本地规则，
# 不会静默切换到另一项可能收费的远程模型。
LIFE_AI_PROVIDER=auto

# ------ CloudBase 公网测试模式 -----------------------------------------------
# 仅用于隔离的 /model-test 页面和 /api/model-test/chat。
# 填写 CloudBase 实际签发的精确主机名；多个主机名用英文逗号分隔。
# 不支持通配符，也不能填写 localhost 或局域网私有 IP。
AIOS_PUBLIC_TEST_HOSTS=

# ------ Web Public Beta（用户请求级 BYOK）------------------------------------
# 填写正式 HTTPS 部署签发的精确主机名；多个主机名用英文逗号分隔。
# 不支持通配符、localhost 或局域网私有 IP。该模式只开放明确列出的最小路由，
# 并要求每位用户在当前页面内存中提供自己的 TokenHub API Key。
AIOS_PUBLIC_BETA_HOSTS=
# 004-PB-03：Public Beta 只支持单个长期运行 Node.js 实例。
# 当前幂等与限流使用单进程内存状态；任何其他值都会让公网模式拒绝服务。
AIOS_PUBLIC_BETA_DEPLOYMENT_MODE=
AIOS_PUBLIC_BETA_INSTANCE_COUNT=
AIOS_PUBLIC_BETA_STATE_BACKEND=
AIOS_PUBLIC_BETA_INSTANCE_ID=
# 与实际部署 commit/tag 一一对应，例如 beta-2026-10-28-abcdef1。
AIOS_PUBLIC_BETA_RELEASE_ID=
# 反向代理和匿名会话各自使用独立、随机、至少 32 字符的秘密。
# 这里只保留变量名，真实值必须放在服务器受限环境文件中。
AIOS_PUBLIC_BETA_INGRESS_SECRET=
AIOS_PUBLIC_BETA_SESSION_SECRET=
# 当前运行版本 Corresponding Source 的真实 HTTPS 地址。
# 未配置时 Public Beta 会拒绝服务，不得填写虚假占位链接。
AIOS_PUBLIC_BETA_SOURCE_URL=

# ------ 可选：SSH 隧道个人 Alpha（默认关闭）--------------------------------
# 仅当 Host 完整等于配置值，且是 HTTP 回环地址时启用 TokenHub BYOK。
# 不要填写公网域名、局域网 IP、通配符或其他端口。
AIOS_PERSONAL_ALPHA_BYOK=0
AIOS_PERSONAL_ALPHA_BYOK_HOST=

# ------ Telegram — Check-in Bot -----------------------------------------------
# Create a bot via @BotFather → /newbot → copy the token it gives you
TELEGRAM_BOT_TOKEN=
# Public username of your check-in bot (shown to users in Settings → setup instructions)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Webhook secret: random 32-char string to authenticate Telegram's POST requests
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=

# ------ Telegram — Food Logger Bot --------------------------------------------
# Create a second bot via @BotFather for food logging
TELEGRAM_FOOD_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_FOOD_BOT_USERNAME=your_food_bot_username

# ------ Cron Security ---------------------------------------------------------
# Random secret used to authenticate calls to /api/telegram/cron from your scheduler
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# ------ ChatGPT 套餐接入（官方 Sign in with ChatGPT）----------------------------
# 不使用 OpenRouter 时的首选方案：用你自己的 ChatGPT Plus/Pro 套餐跑真实 AI 解析。
# 这里不存放任何密钥。授权由你本人在浏览器完成，令牌只保存在
# %USERPROFILE%\.config\ai-lifeos\chatgpt-plan.json，不会进入 Git，也不会发给浏览器。
# 模型可通过 GET /api/life-records/chatgpt-plan/authorize 后由服务端自动列出。
CHATGPT_PLAN_MODEL=gpt-6.1-sol
# 可选：图片理解使用的模型。必须是可以接收图片的模型；不要把纯文本模型写在这里。
CHATGPT_PLAN_VISION_MODEL=
# 可选：覆盖授权文件位置（仅用于测试或把令牌放到别的磁盘）。
# CHATGPT_PLAN_CREDENTIALS_FILE=<YOUR_HOME>\.config\ai-lifeos\chatgpt-plan.json
# 可选：固定本机 host 标识；留空时首次授权自动生成并保持不变。
# CHATGPT_PLAN_HOST_ID=

# ------ App URL ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Change to your production URL before deploying: https://your-app.vercel.app
